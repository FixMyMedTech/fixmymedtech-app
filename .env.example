# PostgreSQL connection string (asyncpg driver)
# For local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/fixmymedtech
# For Supabase pooler: postgresql+asyncpg://postgres.[project]:[password]@aws-0-eu-region-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[yourpassword]@db.[yourprojectid].supabase.co:5432/postgres

# Schema the app tables live in
DB_SCHEMA=fixmymedtech

FRONTEND_URL=http://localhost:8888
# Public URL of the FastAPI backend. Used as the base for email verification
# links (e.g. http://localhost:8888 or https://api.fixmymedtech.org).
API_BASE_URL=http://localhost:8888
LOGO_URL=

# JWT secret used to sign FastAPI-Users tokens (>= 32 bytes; change in production!)
# Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-to-a-random-32-byte-secret!

# Photo preprocessing: whiten background before storing device photos.
# AUTO_PROCESS_PHOTO=off disables; set GEMINI_API_KEY to prefer the Gemini
# "Nano Banana" image-edit API over the local rembg model. Local rembg needs
# internet once to download its ~176MB model on first use.
AUTO_PROCESS_PHOTO=on
GEMINI_API_KEY=
GEMINI_PHOTO_MODEL=gemini-2.5-flash-image

# Photo compression (downscale + JPEG re-encode before storing in MinIO)
PHOTO_MAX_DIMENSION=1600
PHOTO_JPEG_QUALITY=85
# ── Copy to .env and edit. This covers a full local run ─────────────────────
#   Fastest local setup (recommended): start local Postgres + MinIO, then:
#       docker compose up -d --build backend frontend
#   The backend is served on http://localhost:8888 (FRONTEND_URL below).
#
#   Or run against a hosted Supabase project by swapping DATABASE_URL for the
#   pooler URI (project ↦ db name, and set the password).

# PostgreSQL connection string (asyncpg driver)
# For local Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fixmymedtech
# For Supabase pooler:
# DATABASE_URL=postgresql+asyncpg://postgres.[yourproject]:[password]@aws-0-eu-region-1.pooler.supabase.com:5432/postgres

# Schema the app tables live in
DB_SCHEMA=fixmymedtech

# URL of the SPA — used for email links and the frontend <-> backend proxy.
# http://localhost:8888 when served through the backend proxy (default compose).
FRONTEND_URL=http://localhost:8888
# Public URL of the FastAPI backend (used as base for email verification links).
API_BASE_URL=http://localhost:8888
# Internal address the frontend uses to reach the backend over Docker's network.
# Use http://localhost:8888 when running the frontend on the host instead.
API_URL=http://backend:8888
LOGO_URL=

# JWT secret used to sign FastAPI-Users tokens (>= 32 bytes; change in production!)
# Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-to-a-random-32-byte-secret!

# ── SMTP (email verification / password reset / invitations) ────────────────
# Leave empty to skip sending (emails won't be delivered). Example for Gmail
# app password, or use any SMTP server / Resend-compatible endpoint:
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ── MinIO object storage (device photos) ─────────────────────────────────────
# Inside docker compose the backend reaches MinIO as `minio:9000`.
# Use 127.0.0.1:9000 when running the backend on the host.
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=fixmymedtech

# ── Device photo preprocessing ───────────────────────────────────────────────
# AUTO_PROCESS_PHOTO=off disables; set GEMINI_API_KEY to prefer the Gemini
# "Nano Banana" image-edit API over the local rembg model. Local rembg needs
# internet once to download its ~176MB model on first use.
AUTO_PROCESS_PHOTO=on
GEMINI_API_KEY=
GEMINI_PHOTO_MODEL=gemini-2.5-flash-image

# Photo compression (downscale + JPEG re-encode before storing in MinIO)
PHOTO_MAX_DIMENSION=1600
PHOTO_JPEG_QUALITY=85

# ── Optional OAuth logins (Google / GitHub / Discord) ────────────────────────
# Leave empty to disable a provider's login button.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
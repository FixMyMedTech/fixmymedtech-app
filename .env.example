# ── Local development ───────────────────────────────────────────────────────
# Runs everything on your machine (PostgreSQL, MinIO, backend, frontend) with
# the values below; no external accounts needed:
#
#     cp .env.example .env
#     docker compose -f docker-compose.local.yml up --build -d
#
#   App:            http://localhost:8890   (frontend alone: http://localhost:5003)
#   API docs:       http://localhost:8890/docs
#   Admin portal:   http://localhost:8890/admin/   (needs a superuser, see below)
#   MinIO console:  http://localhost:9003           (minioadmin / minioadmin)
#
# Everything below works as-is for that local stack. Optional features (email,
# social login, Discord, photo AI) stay off until you fill them in.

# ── Database ─────────────────────────────────────────────────────────────────
# The local stack uses its own PostgreSQL container and ignores DATABASE_URL.
# It is used when you run the backend outside Docker (docs: "Running Without
# Docker") or with docker-compose.yml / docker-compose.dev.yml (Supabase), e.g.
#   DATABASE_URL=postgresql+asyncpg://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fixmymedtech
DB_SCHEMA=fixmymedtech
# Host ports of the local stack. 8890 / 5003 leave 8888 / 5001 free for the
# Supabase stack (docker-compose.yml), so both can run at once. Change any
# that are already used on your machine (e.g. 5432 by another PostgreSQL).
# The app is at http://localhost:<LOCAL_BACKEND_PORT>.
LOCAL_DB_PORT=5432
LOCAL_BACKEND_PORT=8890
LOCAL_FRONTEND_PORT=5003
LOCAL_MINIO_PORT=9002
LOCAL_MINIO_CONSOLE_PORT=9003

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public address of the app and of the API, used in email links and
# redirects. The local stack ignores these and uses
# http://localhost:<LOCAL_BACKEND_PORT>; they're for the other stacks.
FRONTEND_URL=http://localhost:8888
API_BASE_URL=http://localhost:8888
# How the frontend reaches the backend: the container name inside Docker,
# http://localhost:8888 when you run the frontend outside Docker.
API_URL=http://backend:8888

# ── Secrets ──────────────────────────────────────────────────────────────────
# Fine for local use. On dev/production servers these come from GitHub
# secrets; generate real ones with:  openssl rand -base64 48
SESSION_SECRET=local-dev-session-secret-change-me
AUTH_JWT_SECRET=local-dev-jwt-secret-change-me-32-bytes!
AUTH_SESSION_SECRET=local-dev-admin-session-secret-change-me

# ── First admin (optional) ───────────────────────────────────────────────────
# Fill these in and the backend creates this superuser on startup (or resets
# its password if it exists). Leave empty and create one later with:
#   docker compose -f docker-compose.local.yml exec backend python utils/create_superuser.py
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
SUPERUSER_NAME=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Signup verification, password reset and invitations. With MAIL_SERVER empty
# nothing is sent: the backend log shows "email NOT sent" instead.
# Example (Resend): MAIL_SERVER=smtp.resend.com, MAIL_PORT=587,
# MAIL_USERNAME=resend, MAIL_PASSWORD=<API key>, MAIL_FROM=<verified sender>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=FixMyMedTech
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
# Logo shown in emails. Leave commented out to use the default logo.
# LOGO_URL=

# ── File storage (MinIO) ─────────────────────────────────────────────────────
# Device photos, avatars and uploaded documents. The local stack starts MinIO
# itself and reaches it as minio:9000; use 127.0.0.1:9002 when you run the
# backend outside Docker against the local stack's MinIO.
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=fixmymedtech
# Largest PDF that can be uploaded to the document library, in MB.
DOCUMENT_MAX_MB=50

# ── Device photos ────────────────────────────────────────────────────────────
# Photos get a white background in the background. With GEMINI_API_KEY empty
# the local rembg model is used; it downloads ~176 MB on the first photo.
# Set AUTO_PROCESS_PHOTO=off to skip this entirely.
AUTO_PROCESS_PHOTO=on
GEMINI_API_KEY=
GEMINI_PHOTO_MODEL=gemini-2.5-flash-image
PHOTO_MAX_DIMENSION=1600
PHOTO_JPEG_QUALITY=85

# ── Health facility lookup (optional) ────────────────────────────────────────
# API key for healthsites.io, used to import hospitals and clinics.
HEALTHSITES_API_KEY=

# ── Social login (optional) ──────────────────────────────────────────────────
# Leave empty to hide a provider's login button. Redirect URL to register with
# the provider: http://localhost:8888/api/auth/oauth/<provider>/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Discord (optional) ───────────────────────────────────────────────────────
# Feedback button: webhook of a Discord FORUM channel (Channel settings →
# Integrations → Webhooks); each report becomes a thread. Empty = reports are
# only stored (see /admin → Feedback).
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_FEEDBACK_TAG_ID=
DISCORD_ISSUE_TAG_ID=
# Welcome channel webhook: welcomes people who connect Discord and announces
# new devices. Connecting Discord needs the Discord login above.
DISCORD_WELCOME_WEBHOOK_URL=
